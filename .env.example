# ModularMenu Unified Environment Configuration Baseline

# Core Platform
PROJECT_NAME=ModularMenu
VERSION=1.0.0
ENVIRONMENT=development
# Choose 'managed' for Platform SaaS or 'self_hosted' for Customer Docker Profile
DEPLOYMENT_MODE=managed
DEBUG=true

# Domain & URLs
PUBLIC_BASE_URL=http://localhost:3000
API_V1_PREFIX=/api/v1

# Security Secrets
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Database Configuration (PostgreSQL 16)
DATABASE_URL=sqlite+aiosqlite:///./modularmenu.db
# Production PostgreSQL URL:
# DATABASE_URL=postgresql+asyncpg://modularmenu:devpassword123@localhost:5432/modularmenu_db

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Media Storage Configuration
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# S3 Configuration (Optional for cloud object storage)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Customer-Hosted Licensing
LICENSE_KEY=
LICENSE_GRACE_PERIOD_DAYS=30
