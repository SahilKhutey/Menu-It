# ModularMenu Unified Environment Configuration Baseline (ARC-11 §3.2)

# Core Platform & Environment
APP_NAME=ModularMenu
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true
ENVIRONMENT=development
DEPLOYMENT_MODE=managed
DEBUG=true

# Domain & URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
PUBLIC_BASE_URL=http://localhost:3000
API_PREFIX=/api/v1
API_V1_PREFIX=/api/v1

# Security & Secrets
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Session Cookies
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://modularmenu:devpassword123@localhost:5432/modularmenu
# SQLite fallback for local test execution:
# DATABASE_URL=sqlite+aiosqlite:///./modularmenu.db

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
POSTGRES_USER=modularmenu
POSTGRES_PASSWORD=devpassword123

# Ephemeral Cache (Redis is optional - ARC-11 §11)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Media Object Storage Configuration (ARC-11 §10)
STORAGE_BACKEND=local
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
STORAGE_LOCAL_PATH=./uploads

# S3 Object Storage (For Profile C Managed SaaS)
S3_BUCKET_NAME=
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Logging & Observability
LOG_LEVEL=INFO

# Customer-Hosted Licensing
LICENSE_KEY=
LICENSE_GRACE_PERIOD_DAYS=30
