# ModularMenu Unified Environment Configuration Baseline (ARC-11 §3.2)

# Core Platform & Environment
APP_NAME=ModularMenu
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true
ENVIRONMENT=development
DEPLOYMENT_MODE=managed
DEBUG=true

# Domain & URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
PUBLIC_BASE_URL=http://localhost:3000
API_PREFIX=/api/v1
API_V1_PREFIX=/api/v1

# Security & Secrets
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Session Cookies
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# Database Configuration (PostgreSQL 17 / FCD-03)
POSTGRES_USER=menu_it
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_DB=menu_it
DATABASE_URL=postgresql+asyncpg://menu_it:change_this_local_password@localhost:5432/menu_it
DATABASE_TEST_URL=postgresql+asyncpg://menu_it_test:change_this_test_password@localhost:5432/menu_it_test
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# Ephemeral Cache (Redis is optional - ARC-11 §11)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Media Object Storage Configuration (ARC-11 §10)
STORAGE_BACKEND=local
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
STORAGE_LOCAL_PATH=./uploads

# S3 Object Storage (For Profile C Managed SaaS)
S3_BUCKET_NAME=
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Logging & Observability
LOG_LEVEL=INFO

# Customer-Hosted Licensing
LICENSE_KEY=
LICENSE_GRACE_PERIOD_DAYS=30
