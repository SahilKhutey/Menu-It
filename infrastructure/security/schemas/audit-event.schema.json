{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModularMenu Audit Event Schema",
  "type": "object",
  "required": [
    "event_id",
    "occurred_at",
    "action",
    "resource_type",
    "outcome",
    "correlation_id"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor_user_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "organization_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "action": {
      "type": "string"
    },
    "resource_type": {
      "type": "string"
    },
    "resource_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "denied"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    }
  }
}
