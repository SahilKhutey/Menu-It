{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModularMenu Security Policy Schema",
  "type": "object",
  "required": [
    "version",
    "policy_name",
    "rules"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "policy_name": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "severity",
          "enforcement"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "enforcement": {
            "type": "string"
          }
        }
      }
    }
  }
}
