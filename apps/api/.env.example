# ==============================================================================
# Menu-It API — Environment Configuration Template (.env.example)
# Copy this file to .env or .env.development for local development.
# Real credentials and secrets must NEVER be committed to version control.
# ==============================================================================

# Application
APP_NAME=Menu-It API
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# API Server
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
DOCS_ENABLED=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Localization Defaults
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# Database
DATABASE_URL=postgresql+asyncpg://menu_it:change_this_local_password@localhost:5432/menu_it
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# Authentication & Tokens
AUTH_ISSUER=menu-it
AUTH_AUDIENCE=menu-it-api
AUTH_SECRET_KEY=menu-it-dev-insecure-secret-key-32b-length-at-least
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_LOCKOUT_SECONDS=900
AUTH_MAX_FAILED_LOGINS=5
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# File Storage
FILE_STORAGE_BACKEND=local
FILE_STORAGE_ROOT=./storage
FILE_MAX_UPLOAD_BYTES=10485760
FILE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Notifications
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_PROVIDER=console
NOTIFICATION_DEFAULT_FROM=noreply@menu-it.com

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text
