# ModularMenu — Customer-Hosted Deployment Profile
DEPLOYMENT_MODE=self_hosted
ENVIRONMENT=production
SECRET_KEY=change_this_to_a_random_64_character_hex_string
PUBLIC_BASE_URL=https://menu.yourrestaurant.com

# PostgreSQL Container Credentials
POSTGRES_USER=modularmenu
POSTGRES_PASSWORD=generate_a_very_secure_db_password
POSTGRES_DB=modularmenu_db

# Storage Provider
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/app/uploads

# Cryptographic License Key
LICENSE_KEY=MMLIC-PRO-ENTERPRISE-VERIFIED
LICENSE_GRACE_PERIOD_DAYS=30
