      "layout-grid": {
        "supported_slots": ["header", "navigation", "content", "category.header", "category.items", "footer"],
        "min_columns": 1,
        "max_columns": 4
      },
      "layout-image-cards": {
        "supported_slots": ["header", "navigation", "content", "category.header", "category.items", "footer"],
        "min_columns": 1,
        "max_columns": 3
      },
      "layout-editorial": {
        "supported_slots": ["header", "navigation", "content", "category.header", "category.items", "footer"],
        "min_columns": 1,
        "max_columns": 2
      }
    }
  }
}
