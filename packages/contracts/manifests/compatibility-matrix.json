{
  "schema_version": "1.0.0",
  "compatibility": {
    "themes": {
      "theme-luxury": {
        "supported_layouts": ["layout-grid", "layout-image-cards", "layout-editorial", "layout-list"],
        "deprecated": false
      },
      "theme-minimal": {
        "supported_layouts": ["layout-list", "layout-grid", "layout-image-cards", "layout-editorial"],
        "deprecated": false
      },
      "theme-rustic": {
        "supported_layouts": ["layout-grid", "layout-list", "layout-image-cards", "layout-editorial"],
        "deprecated": false
      },
      "theme-contemporary": {
        "supported_layouts": ["layout-grid", "layout-list", "layout-image-cards", "layout-editorial"],
        "deprecated": false
      },
      "theme-vibrant": {
        "supported_layouts": ["layout-grid", "layout-image-cards", "layout-editorial", "layout-list"],
        "deprecated": false
      },
      "theme-editorial": {
        "supported_layouts": ["layout-editorial", "layout-image-cards", "layout-grid", "layout-list"],
        "deprecated": false
      }
    },
    "layouts": {
      "layout-list": {
        "supported_slots": ["header", "navigation", "content", "category.header", "category.items", "footer"],
