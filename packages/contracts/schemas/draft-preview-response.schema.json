{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://modularmenu.dev/schemas/draft-preview-response.schema.json",
  "title": "DraftMenuPreviewResponse",
  "description": "Authorized draft preview response with validation warnings and draft state (ARC-09 §12.4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "restaurant", "menu", "resolved_configuration", "preview"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["render_mode", "menu_id", "schema_version", "locale", "currency"],
      "properties": {
        "render_mode": { "type": "string", "enum": ["preview"] },
        "menu_id": { "type": "string" },
        "locale": { "type": "string" },
        "currency": { "type": "string" },
        "schema_version": { "type": "string" }
      }
    },
    "restaurant": { "type": "object" },
    "menu": { "type": "object" },
    "resolved_configuration": { "type": "object" },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "valid", "warnings"],
      "properties": {
        "revision": { "type": "integer" },
        "valid": { "type": "boolean" },
        "warnings": { "type": "array" },
        "generated_at": { "type": "string" }
      }
    }
  }
}
