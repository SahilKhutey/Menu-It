{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.modularmenu.com/schemas/publication-validation.schema.json",
  "title": "PublicationValidation",
  "type": "object",
  "required": ["validation_id", "menu_id", "draft_revision", "result", "errors", "warnings", "validated_at"],
  "properties": {
    "validation_id": { "type": "string", "format": "uuid" },
    "menu_id": { "type": "string", "format": "uuid" },
    "draft_revision": { "type": "integer", "minimum": 1 },
    "result": { "type": "string", "enum": ["PASSED", "FAILED", "WARNING"] },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "validated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "required": ["code", "path", "message", "severity"],
      "properties": {
        "code": { "type": "string" },
        "path": { "type": "string" },
        "message": { "type": "string" },
        "severity": { "type": "string", "enum": ["ERROR", "WARNING", "INFO"] }
      }
    }
  },
  "additionalProperties": false
}
