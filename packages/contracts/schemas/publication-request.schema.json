{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.modularmenu.com/schemas/publication-request.schema.json",
  "title": "PublicationRequest",
  "type": "object",
  "required": ["draft_revision"],
  "properties": {
    "draft_revision": { "type": "integer", "minimum": 1 },
