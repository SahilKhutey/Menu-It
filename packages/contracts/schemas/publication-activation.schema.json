{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.modularmenu.com/schemas/publication-activation.schema.json",
  "title": "PublicationActivation",
  "type": "object",
  "required": [
    "id",
    "organization_id",
    "menu_id",
    "publication_id",
    "operation_id",
    "activation_reason",
    "activated_at"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "organization_id": { "type": "string", "format": "uuid" },
    "menu_id": { "type": "string", "format": "uuid" },
    "publication_id": { "type": "string", "format": "uuid" },
    "previous_publication_id": { "type": ["string", "null"], "format": "uuid" },
    "operation_id": { "type": "string", "format": "uuid" },
    "activation_reason": { "type": "string", "enum": ["publish", "rollback", "scheduled", "recovery"] },
    "actor_id": { "type": ["string", "null"], "format": "uuid" },
    "activated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
