{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://modularmenu.dev/schemas/render-plan.schema.json",
  "title": "MenuRenderPlan",
  "description": "Deterministic presentation rendering plan generated by packages/menu-renderer (ARC-09 §5.3).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "theme", "layout", "root", "warnings"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "theme": {
      "type": "object",
      "required": ["id", "version", "tokens"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "tokens": { "type": "object" }
      }
    },
    "layout": {
      "type": "object",
      "required": ["id", "version", "slots"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "slots": { "type": "array", "items": { "type": "string" } }
      }
    },
    "root": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "componentId", "componentVersion", "slot", "order", "props"],
        "properties": {
          "id": { "type": "string" },
          "componentId": { "type": "string" },
          "componentVersion": { "type": "string" },
          "slot": { "type": "string" },
          "order": { "type": "integer" },
          "props": { "type": "object" },
          "children": { "type": "array" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
